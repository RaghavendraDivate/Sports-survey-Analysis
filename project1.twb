      </column>
      <column caption='Numeric Rating' datatype='integer' name='[Calculation_1547901279486832641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [10. How would you rate the current sports facilities in your college?]&#10;    WHEN &quot;Poor&quot; THEN 1&#10;    WHEN &quot;Fair&quot; THEN 2&#10;    WHEN &quot;Good&quot; THEN 3&#10;    WHEN &quot;Excellent&quot; THEN 4&#10;END' />
      </column>
      <column caption='Ranking sport' datatype='integer' name='[Calculation_1547901279498932229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Calculation_1265018927717294080]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
